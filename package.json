{
  "name": "schsrch",
  "version": "3.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "MONGODB=mongodb://127.0.0.1/schsrch ES=127.0.0.1:9200 node server.js",
    "install": "if [ -e binding.gyp ]; then node-gyp rebuild; fi",
    "prepare": "if [ -e webpack.config.js ]; then npm run webpack; fi",
    "webpack-dev": "NODE_ENV=development webpack --progress --colors --watch",
    "webpack": "NODE_ENV=production webpack --progress; if [ $? -eq 0 ]; then echo OK.; else echo Failed && exit 1.; fi",
    "test": "bash test/prepareDatabase.sh && STORAGE_ROOT=test/papers_download_test/pastpapers mocha --delay --exit",
    "coverage": "STORAGE_ROOT=test/papers_download_test/pastpapers node_modules/.bin/istanbul cover -x \"**/dist-server/**\" --report lcovonly node_modules/.bin/_mocha -- --delay --exit -R spec",
    "coverage-html": "node_modules/.bin/istanbul cover -x \"**/dist-server/**\" node_modules/.bin/_mocha -- --delay --exit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiskaWasTaken/schsrch.git"
